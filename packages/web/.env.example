# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection string used by both Prisma and the plugin's own config.
DATABASE_URL="mysql://voidbans:password@localhost:3306/voidbans"

# Random string, 32+ chars, used to sign staff session cookies.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=""

# Public URL this site is deployed at — also set as `site-url` in the
# plugin's config.yml so in-game ban messages link to the right place.
SITE_URL="https://your-domain.example"

# Discord OAuth application (Discord Developer Portal > Applications).
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="https://your-domain.example/api/auth/callback"

# Bot token for a bot invited to your guild, used server-side only to read
# a logging-in user's roles (guild member roles aren't visible via a plain
# `identify` OAuth scope). Needs "View Server Members" / members intent.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
