generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev on whatever platform that happens to be;
  // the linux-musl targets are required for the node:20-alpine Docker
  // image (Alpine uses musl libc, not glibc — Prisma's engine binaries
  // are platform+libc specific and won't run across that boundary).
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Players & sessions ──────────────────────────────────────────────

model Player {
  uuid               String   @id @db.Char(36)
  username           String   @db.VarChar(16)
  lastSeenUsername   String   @db.VarChar(16)
  firstJoined        DateTime
  lastLogin          DateTime?
  lastLogout         DateTime?
  isOnline           Boolean  @default(false)
  // False only for a row staff pre-created (via the pre-ban lookup) for a
  // UUID that has never actually connected — firstJoined on such a row is
  // just the time it was created, not a real join, so the UI must not show
  // it as one. The plugin's own INSERT ... ON DUPLICATE KEY UPDATE on
  // login always sets this back to TRUE, absorbing the placeholder into a
  // real player row the moment they actually connect.
  hasJoined          Boolean  @default(true)

  sessions       Session[]
  punishments    Punishment[]
  usernameHistory UsernameHistory[]
  notes          PlayerNote[]
  violations     ViolationEvent[]
  attachments    PlayerAttachment[]

  @@index([username])
  @@index([isOnline])
  @@map("players")
}

// Append-only — a new row whenever a login's reported username differs
// from players.lastSeenUsername, so staff can recognize a renamed player.
model UsernameHistory {
  id         BigInt   @id @default(autoincrement())
  playerUuid String   @db.Char(36)
  username   String   @db.VarChar(16)
  observedAt DateTime @default(now())

  player Player @relation(fields: [playerUuid], references: [uuid], onDelete: Cascade)

  @@index([playerUuid])
  @@map("username_history")
}

// Freeform, non-punishment staff notes on a player — e.g. "suspected alt
// of X, watching" — distinct from a punishment: it's not an action taken
// against the player, just context for other staff.
model PlayerNote {
  id             BigInt   @id @default(autoincrement())
  playerUuid     String   @db.Char(36)
  body           String   @db.Text
  authorDiscordId String  @db.VarChar(32)
  authorUsername String   @db.VarChar(64)
  createdAt      DateTime @default(now())

  player Player @relation(fields: [playerUuid], references: [uuid], onDelete: Cascade)

  @@index([playerUuid])
  @@map("player_notes")
}

// Staff-uploaded PNG evidence, attached to a player generally or to one
// specific punishment. Image bytes live in the row (bytesSize is capped at
// upload time) — this app has no file storage/volume, and evidence images
// from staff are small enough that a DB blob avoids needing one.
model PlayerAttachment {
  id              BigInt   @id @default(autoincrement())
  playerUuid      String   @db.Char(36)
  punishmentId    BigInt?
  data            Bytes    @db.MediumBlob
  bytesSize       Int
  caption         String?  @db.VarChar(280)
  authorDiscordId String   @db.VarChar(32)
  authorUsername  String   @db.VarChar(64)
  createdAt       DateTime @default(now())

  player     Player      @relation(fields: [playerUuid], references: [uuid], onDelete: Cascade)
  punishment Punishment? @relation(fields: [punishmentId], references: [id], onDelete: Cascade)

  @@index([playerUuid])
  @@index([punishmentId])
  @@map("player_attachments")
}

model Session {
  id              BigInt    @id @default(autoincrement())
  playerUuid      String    @db.Char(36)
  loginAt         DateTime
  logoutAt        DateTime?
  durationSeconds Int?
  serverId        String    @db.VarChar(64)
  ipAddress       String?   @db.VarChar(45)
  // Reported client brand at login (e.g. "vanilla", "lunarclient",
  // "feather"). Sourced from Vulcan's IPlayerData.getClientBrand() when
  // the Vulcan integration is enabled — null if Vulcan isn't installed
  // or the integration is turned off in Settings.
  clientBrand     String?   @db.VarChar(64)

  player Player @relation(fields: [playerUuid], references: [uuid], onDelete: Cascade)

  @@index([playerUuid])
  @@index([loginAt])
  @@index([ipAddress])
  @@map("sessions")
}

// One row per Vulcan flag (a detected, possibly-not-yet-punishable
// violation) or punish action, populated by the plugin's VulcanIntegration
// listener. Exists independently of Vulcan being currently installed —
// history already recorded stays visible even if the integration is later
// disabled, only new rows stop being written.
model ViolationEvent {
  id          BigInt   @id @default(autoincrement())
  playerUuid  String   @db.Char(36)
  checkName   String   @db.VarChar(64)
  category    String   @db.VarChar(64)
  violationLevel Int
  info        String?  @db.Text
  punished    Boolean  @default(false)
  occurredAt  DateTime @default(now())

  player Player @relation(fields: [playerUuid], references: [uuid], onDelete: Cascade)

  @@index([playerUuid])
  @@index([occurredAt])
  @@map("violation_events")
}

// ── Punishments & appeals ───────────────────────────────────────────

enum PunishmentType {
  BAN
  MUTE
  KICK
  WARN
}

enum AppealStatus {
  PENDING
  ACCEPTED
  DENIED
}

model Punishment {
  id             BigInt         @id @default(autoincrement())
  publicBanId    String         @unique @db.VarChar(16)
  playerUuid     String         @db.Char(36)
  type           PunishmentType
  reason         String         @db.Text
  templateId     BigInt?
  staffDiscordId String?        @db.VarChar(32)
  staffUsername  String?        @db.VarChar(64)
  issuedAt       DateTime       @default(now())
  expiresAt      DateTime?
  active         Boolean        @default(true)
  revokedBy      String?        @db.VarChar(32)
  revokedAt      DateTime?
  revokeReason   String?        @db.Text
  appealable     Boolean        @default(false)
  ipAddress      String?        @db.VarChar(45)
  ipBanned       Boolean        @default(false)

  player      Player                @relation(fields: [playerUuid], references: [uuid], onDelete: Cascade)
  template    PunishmentTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  appeal      Appeal?
  attachments PlayerAttachment[]
  ruleLinks   PunishmentRuleLink[]

  @@index([playerUuid])
  @@index([active])
  @@index([ipAddress])
  @@map("punishments")
}

model Appeal {
  id               BigInt       @id @default(autoincrement())
  punishmentId     BigInt       @unique
  submittedAt      DateTime     @default(now())
  answers          Json
  status           AppealStatus @default(PENDING)
  staffResponse    String?      @db.Text
  resolvedByDiscordId String?   @db.VarChar(32)
  resolvedAt       DateTime?
  autoRevoked      Boolean      @default(false)

  punishment Punishment @relation(fields: [punishmentId], references: [id], onDelete: Cascade)

  @@map("appeals")
}

model AppealQuestion {
  id        BigInt  @id @default(autoincrement())
  prompt    String  @db.VarChar(280)
  sortOrder Int     @default(0)
  required  Boolean @default(true)
  active    Boolean @default(true)

  @@map("appeal_questions")
}

model PunishmentTemplate {
  id                BigInt         @id @default(autoincrement())
  name              String         @db.VarChar(64)
  type              PunishmentType
  defaultReason     String         @db.Text
  defaultDuration   Int?
  defaultAppealable Boolean        @default(false)
  createdByDiscordId String        @db.VarChar(32)
  createdAt         DateTime       @default(now())

  punishments Punishment[]

  @@map("punishment_templates")
}

// A category grouping rules — "Chat Rules", "Severe Rules", etc. Drives
// both the public /rules page (grouped sections, in sortOrder) and the
// rule picker when punishing. This replaced a hand-written Markdown page
// as the single source of truth: editing a rule here updates both places
// at once instead of two independently-maintained copies drifting apart.
model RuleCategory {
  id          BigInt @id @default(autoincrement())
  name        String @db.VarChar(64)
  description String? @db.Text
  sortOrder   Int     @default(0)

  rules PunishmentRule[]

  @@map("rule_categories")
}

// A rule from the server's rulebook, selectable when issuing a punishment
// and shown publicly on /rules under its category. Most real rules don't
// dictate a fixed punishment — severity is a staff judgment call made
// after seeing the player's history — so type/duration/appealable are
// optional per rule rather than required the way a template's are: a
// rule can suggest a default if the owner wants, but citing one at
// punish time never forces a specific action or length.
model PunishmentRule {
  id                BigInt         @id @default(autoincrement())
  categoryId        BigInt
  code              String         @db.VarChar(16)
  title             String         @db.VarChar(120)
  description       String?        @db.Text
  suggestedType     PunishmentType?
  defaultDuration   Int?
  defaultAppealable Boolean        @default(false)
  active            Boolean        @default(true)
  sortOrder         Int            @default(0)
  createdByDiscordId String        @db.VarChar(32)
  createdAt         DateTime       @default(now())

  category        RuleCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  punishmentLinks PunishmentRuleLink[]

  @@unique([code])
  @@index([categoryId])
  @@map("punishment_rules")
}

// Many-to-many: a single punishment can cite more than one broken rule
// (e.g. harassment + spam in the same incident), so this can't be a
// plain nullable FK on Punishment the way templateId is.
model PunishmentRuleLink {
  punishmentId BigInt
  ruleId       BigInt

  punishment Punishment     @relation(fields: [punishmentId], references: [id], onDelete: Cascade)
  rule       PunishmentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([punishmentId, ruleId])
  @@index([ruleId])
  @@map("punishment_rule_links")
}

// ── Staff, roles & permissions ──────────────────────────────────────

model StaffRole {
  id             BigInt  @id @default(autoincrement())
  discordRoleId  String  @unique @db.VarChar(32)
  discordRoleName String @db.VarChar(100)
  displayName    String  @db.VarChar(100)
  color          String? @db.VarChar(7)
  isOwnerRole    Boolean @default(false)

  permissions StaffPermission[]

  @@map("staff_roles")
}

model StaffPermission {
  roleId         BigInt
  permissionKey  String @db.VarChar(64)

  role StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("staff_permissions")
}

model StaffUser {
  discordId     String   @id @db.VarChar(32)
  username      String   @db.VarChar(64)
  avatarHash    String?  @db.VarChar(64)
  discordRoles  Json
  isOwner       Boolean  @default(false)
  lastLoginAt   DateTime?
  // Self-linked Minecraft account, required before the dashboard is
  // usable (enforced at /staff/link-account) — this is what lets the
  // punishment API refuse to let staff action another staff member's
  // Player row. Nullable only because it doesn't exist until the staff
  // member completes that one-time step; every login re-checks for null.
  minecraftUuid String?  @unique @db.Char(36)
  // Set once this staff member has tried to link (their first lookup
  // failed — they've genuinely never joined the server) AND chosen to
  // continue without linking for now. Lets the dashboard gate let them
  // through unlinked rather than stuck at /staff/link-account forever,
  // while still nudging them to finish linking once they have joined.
  minecraftLinkSkippedAt DateTime?

  @@map("staff_users")
}

// Append-only record of who did what. Nothing in the app updates or
// deletes these rows — there is deliberately no route or UI that can.
// actorDiscordId is null for events with no authenticated actor (a failed
// login, a public appeal submission). actorUsername is a snapshot taken at
// write time, because staff nicknames change and the record has to keep
// saying who the person was when it happened.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  actorDiscordId String?  @db.VarChar(32)
  actorUsername  String?  @db.VarChar(64)
  action         String   @db.VarChar(64)
  targetType     String   @db.VarChar(64)
  targetId       String   @db.VarChar(64)
  // success | denied | failure
  outcome        String   @default("success") @db.VarChar(16)
  details        Json?
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(255)
  createdAt      DateTime @default(now())

  @@index([actorDiscordId])
  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ── Server-wide settings (owner-editable singletons) ────────────────

model SiteSetting {
  key   String @id @db.VarChar(64)
  value Json

  @@map("site_settings")
}
