# Copy to .env in the repo root — this is what docker-compose.yml reads.
# Never commit .env.

MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 32+ random chars — generate with: openssl rand -base64 48
SESSION_SECRET=

SITE_URL=https://your-domain.example

# Shown on the privacy policy and terms pages. Leave blank to show "the server staff".
CONTACT_EMAIL=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-domain.example/api/auth/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
